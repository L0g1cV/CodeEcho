# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=codeecho

# Or use DATABASE_URL directly
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/codeecho?sslmode=disable

# JWT Secret (change in production!)
JWT_SECRET=codeecho-dev-secret-change-in-production

# Server Port
PORT=8080

# MinIO Object Storage (for image uploads)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=codeecho
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
